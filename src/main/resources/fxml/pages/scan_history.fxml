<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox
    spacing="0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.webshield.ui.controllers.ScanHistoryController">

    <!-- Action bar -->
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="ws-card"
          style="-fx-background-radius: 0; -fx-border-radius: 0; -fx-border-width: 0 0 1 0; -fx-border-color: #E2E6ED; -fx-padding: 14 24;">
        <TextField fx:id="tfSearch"
                   promptText="Search history..."
                   styleClass="ws-text-field"
                   prefWidth="240" />
        <ComboBox fx:id="cbWebsiteFilter"
                  promptText="All websites"
                  styleClass="ws-combo"
                  prefWidth="180" />
        <ComboBox fx:id="cbStatusFilter"
                  promptText="All statuses"
                  styleClass="ws-combo"
                  prefWidth="160" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="ws-scroll-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="0" styleClass="ws-content">
            <VBox spacing="14" styleClass="ws-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label styleClass="ws-card-title" text="Scan History" />
                        <Label styleClass="ws-card-subtitle" text="ALL PREVIOUS SECURITY ASSESSMENTS" />
                    </VBox>
                </HBox>
                <Region styleClass="ws-section-divider" />

                <TableView fx:id="tableScanHistory" styleClass="ws-table" VBox.vgrow="ALWAYS" minHeight="300">
                    <columns>
                        <TableColumn fx:id="colScanId"       text="#"          prefWidth="60"  />
                        <TableColumn fx:id="colTarget"       text="Target"     prefWidth="200" />
                        <TableColumn fx:id="colStarted"      text="Started"    prefWidth="160" />
                        <TableColumn fx:id="colDuration"     text="Duration"   prefWidth="110" />
                        <TableColumn fx:id="colStatus"       text="Status"     prefWidth="110" />
                        <TableColumn fx:id="colFindings"     text="Findings"   prefWidth="90"  />
                        <TableColumn fx:id="colCritical"     text="Critical"   prefWidth="80"  />
                        <TableColumn fx:id="colActions"      text=""           prefWidth="90"  />
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="12" minHeight="240">
                            <Label styleClass="ws-empty-icon"  text="≡" />
                            <Label styleClass="ws-empty-title" text="No scan history found" />
                            <Label styleClass="ws-empty-desc"  text="Completed security assessments will be recorded here automatically." />
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>

