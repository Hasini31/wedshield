<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="ws-card" prefWidth="540"
      stylesheets="@../../css/styles.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.webshield.ui.controllers.ImportSpecDialogController">

    <VBox spacing="4">
        <Label fx:id="lblDialogTitle" styleClass="ws-card-title" text="Import API Specification" />
        <Label styleClass="ws-card-subtitle" text="OPENAPI 3.X / SWAGGER 2.0 SPECIFICATION" />
    </VBox>

    <Region styleClass="ws-section-divider" />

    <!-- Project Name -->
    <VBox spacing="6">
        <Label styleClass="ws-field-label" text="Project Name *" />
        <TextField fx:id="tfName" promptText="e.g. Petstore API or Core Billing Service"
                   styleClass="ws-text-field" />
    </VBox>

    <!-- Description -->
    <VBox spacing="6">
        <Label styleClass="ws-field-label" text="Description (Optional)" />
        <TextArea fx:id="taDescription" promptText="Brief notes regarding the API scope, environment, or target server..."
                  prefRowCount="2" styleClass="ws-text-area" wrapText="true" />
    </VBox>

    <!-- Source Type Selector -->
    <VBox spacing="8">
        <Label styleClass="ws-field-label" text="Specification Source *" />
        <HBox spacing="20">
            <RadioButton fx:id="rbFile" text="File Upload (.json, .yaml, .yml)" selected="true">
                <toggleGroup>
                    <ToggleGroup fx:id="sourceGroup" />
                </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="rbUrl" text="Remote Specification URL" toggleGroup="$sourceGroup" />
        </HBox>
    </VBox>

    <!-- File Upload Section -->
    <VBox fx:id="boxFile" spacing="6">
        <Label styleClass="ws-field-label" text="Specification File *" />
        <HBox spacing="8">
            <TextField fx:id="tfFilePath" promptText="Choose a JSON or YAML specification file..."
                       editable="false" styleClass="ws-text-field" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnBrowse" onAction="#onBrowseFile" styleClass="ws-btn-secondary" text="📁 Browse..." />
        </HBox>
        <Label styleClass="ws-field-hint" text="Maximum permitted file size: 5 MB. Supported formats: JSON, YAML." />
    </VBox>

    <!-- URL Section -->
    <VBox fx:id="boxUrl" spacing="6" managed="false" visible="false">
        <Label styleClass="ws-field-label" text="Specification URL *" />
        <TextField fx:id="tfUrl" promptText="https://api.example.com/v3/api-docs"
                   styleClass="ws-text-field" />
        <Label styleClass="ws-field-hint" text="Must be an HTTP/HTTPS URL returning OpenAPI/Swagger content (max 5 MB)." />
    </VBox>

    <!-- Validation Error / Status Label -->
    <Label fx:id="lblError" styleClass="ws-auth-error" wrapText="true" />

    <Region styleClass="ws-section-divider" />

    <!-- Actions -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnCancel" onAction="#onCancel" styleClass="ws-btn-secondary" text="Cancel" />
        <Button fx:id="btnImport" onAction="#onImport" styleClass="ws-btn-primary" text="Import Specification" />
    </HBox>

</VBox>

