<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.webshield.ui.controllers.ReportsController">

    <!-- ===================================================================== -->
    <!-- TOP: 6 Summary Stat Cards                                             -->
    <!-- ===================================================================== -->
    <VBox spacing="12" styleClass="ws-content" style="-fx-padding: 16 20 8 20;">
        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints percentWidth="16.66" />
                <ColumnConstraints percentWidth="16.66" />
                <ColumnConstraints percentWidth="16.66" />
                <ColumnConstraints percentWidth="16.66" />
                <ColumnConstraints percentWidth="16.66" />
                <ColumnConstraints percentWidth="16.70" />
            </columnConstraints>

            <!-- Total Findings -->
            <VBox styleClass="ws-stat-card" spacing="4" GridPane.columnIndex="0">
                <Label styleClass="ws-stat-label" text="TOTAL FINDINGS" />
                <Label fx:id="lblCardTotal" styleClass="ws-stat-value" text="0" />
                <Label styleClass="ws-stat-desc" text="Across all active scans" />
            </VBox>

            <!-- Critical -->
            <VBox styleClass="ws-stat-card" spacing="4" GridPane.columnIndex="1"
                  style="-fx-border-color: #FCA5A5; -fx-background-color: #FEF2F2;">
                <Label styleClass="ws-stat-label" text="CRITICAL" style="-fx-text-fill: #DC2626;" />
                <Label fx:id="lblCardCritical" styleClass="ws-stat-value" text="0" style="-fx-text-fill: #DC2626;" />
                <Label styleClass="ws-stat-desc" text="Immediate remediation" />
            </VBox>

            <!-- High -->
            <VBox styleClass="ws-stat-card" spacing="4" GridPane.columnIndex="2"
                  style="-fx-border-color: #FDBA74; -fx-background-color: #FFF7ED;">
                <Label styleClass="ws-stat-label" text="HIGH SEVERITY" style="-fx-text-fill: #EA580C;" />
                <Label fx:id="lblCardHigh" styleClass="ws-stat-value" text="0" style="-fx-text-fill: #EA580C;" />
                <Label styleClass="ws-stat-desc" text="High priority flaws" />
            </VBox>

            <!-- Medium -->
            <VBox styleClass="ws-stat-card" spacing="4" GridPane.columnIndex="3"
                  style="-fx-border-color: #FDE68A; -fx-background-color: #FFFBEB;">
                <Label styleClass="ws-stat-label" text="MEDIUM" style="-fx-text-fill: #D97706;" />
                <Label fx:id="lblCardMedium" styleClass="ws-stat-value" text="0" style="-fx-text-fill: #D97706;" />
                <Label styleClass="ws-stat-desc" text="Moderate risk issues" />
            </VBox>

            <!-- Low -->
            <VBox styleClass="ws-stat-card" spacing="4" GridPane.columnIndex="4"
                  style="-fx-border-color: #C7D7FB; -fx-background-color: #EBF3FF;">
                <Label styleClass="ws-stat-label" text="LOW SEVERITY" style="-fx-text-fill: #356AE6;" />
                <Label fx:id="lblCardLow" styleClass="ws-stat-value" text="0" style="-fx-text-fill: #356AE6;" />
                <Label styleClass="ws-stat-desc" text="Best practice alerts" />
            </VBox>

            <!-- Informational -->
            <VBox styleClass="ws-stat-card" spacing="4" GridPane.columnIndex="5"
                  style="-fx-border-color: #E2E6ED; -fx-background-color: #F8FAFC;">
                <Label styleClass="ws-stat-label" text="INFORMATIONAL" style="-fx-text-fill: #64748B;" />
                <Label fx:id="lblCardInfo" styleClass="ws-stat-value" text="0" style="-fx-text-fill: #64748B;" />
                <Label styleClass="ws-stat-desc" text="Observation notes" />
            </VBox>
        </GridPane>
    </VBox>

    <!-- ===================================================================== -->
    <!-- MAIN: SplitPane Table and Finding Inspector                           -->
    <!-- ===================================================================== -->
    <SplitPane dividerPositions="0.62" VBox.vgrow="ALWAYS" style="-fx-background-color: #F5F7FA;">

        <!-- LEFT: Findings Table & Search Bar -->
        <VBox spacing="0">
            <!-- Filter & Search Toolbar -->
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="ws-card"
                  style="-fx-background-radius: 0; -fx-border-radius: 0; -fx-border-width: 0 0 1 0; -fx-border-color: #E2E6ED; -fx-padding: 10 16;">
                <TextField fx:id="tfSearch" promptText="Search finding, URL, or parameter..."
                           styleClass="ws-text-field" prefWidth="210" />
                <ComboBox fx:id="cbSeverityFilter" promptText="All severities" styleClass="ws-combo" prefWidth="130" />
                <ComboBox fx:id="cbCategoryFilter" promptText="All categories" styleClass="ws-combo" prefWidth="130" />
                <ComboBox fx:id="cbStatusFilter" promptText="All statuses" styleClass="ws-combo" prefWidth="120" />
                <Button onAction="#onRefresh" styleClass="ws-btn-secondary" text="🔄 Refresh" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblTotalFindingsText" styleClass="ws-badge-info-text" text="0 findings"
                       style="-fx-font-weight: bold; -fx-text-fill: #356AE6;" />
            </HBox>

            <TableView fx:id="tableFindings" styleClass="ws-table" VBox.vgrow="ALWAYS" minHeight="380">
                <columns>
                    <TableColumn fx:id="colSeverity" text="Severity" prefWidth="95" />
                    <TableColumn fx:id="colName" text="Finding Name" prefWidth="180" />
                    <TableColumn fx:id="colTarget" text="Target URL" prefWidth="200" />
                    <TableColumn fx:id="colParam" text="Parameter" prefWidth="85" />
                    <TableColumn fx:id="colConfidence" text="Confidence" prefWidth="95" />
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="90" />
                    <TableColumn fx:id="colDetected" text="Detected" prefWidth="120" />
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="12" minHeight="240">
                        <Label styleClass="ws-empty-icon" text="⚑" />
                        <Label styleClass="ws-empty-title" text="No security findings recorded" />
                        <Label styleClass="ws-empty-desc" text="Run a security assessment against an authorized website to view findings here." />
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <!-- RIGHT: Finding Inspector Details -->
        <ScrollPane fitToWidth="true" styleClass="ws-scroll-pane">
            <VBox spacing="16" styleClass="ws-content" style="-fx-padding: 16;">

                <!-- Detail Pane (visible when finding selected) -->
                <VBox fx:id="detailContentBox" spacing="14" styleClass="ws-card" visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="lblDetailSeverity" styleClass="ws-badge-high" text="HIGH" />
                        <Label fx:id="lblDetailCode" styleClass="ws-card-subtitle" text="WS-HDR-001" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblDetailStatus" styleClass="ws-badge-info" text="OPEN" />
                    </HBox>

                    <Label fx:id="lblDetailTitle" styleClass="ws-card-title" text="Finding Title" wrapText="true"
                           style="-fx-font-size: 15px;" />
                    <Label fx:id="lblDetailCategory" styleClass="ws-card-subtitle" text="SECURITY HEADERS" />
                    <Region styleClass="ws-section-divider" />

                    <!-- Status Change Workflow -->
                    <VBox spacing="8" style="-fx-background-color: #F8FAFC; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #E2E6ED; -fx-border-radius: 6;">
                        <Label styleClass="ws-field-label" text="Manage Finding Status" style="-fx-font-weight: bold;" />
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <ComboBox fx:id="cbUpdateStatus" promptText="Select Status" styleClass="ws-combo" prefWidth="150" />
                            <Button onAction="#onUpdateStatus" styleClass="ws-btn-primary" text="Update" />
                            <Button onAction="#onMarkFalsePositive" styleClass="ws-btn-secondary" text="False Positive" />
                            <Button onAction="#onMarkResolved" styleClass="ws-btn-secondary" text="Resolved" />
                        </HBox>
                        <Label fx:id="lblStatusUpdated" text="" style="-fx-text-fill: #059669; -fx-font-size: 11px;" />
                    </VBox>

                    <VBox spacing="4">
                        <Label styleClass="ws-field-label" text="Affected Target URL" />
                        <Label fx:id="lblDetailUrl" styleClass="ws-info-value" text="https://example.com" wrapText="true" />
                    </VBox>

                    <VBox spacing="4">
                        <Label styleClass="ws-field-label" text="Affected Parameter" />
                        <Label fx:id="lblDetailParam" styleClass="ws-info-value" text="—" />
                    </VBox>

                    <VBox spacing="4">
                        <Label styleClass="ws-field-label" text="Vulnerability Description" />
                        <TextArea fx:id="txtDetailDescription" editable="false" wrapText="true"
                                  prefRowCount="3" styleClass="ws-text-area" />
                    </VBox>

                    <VBox spacing="4">
                        <Label styleClass="ws-field-label" text="Security Impact" />
                        <TextArea fx:id="txtDetailImpact" editable="false" wrapText="true"
                                  prefRowCount="2" styleClass="ws-text-area" />
                    </VBox>

                    <VBox spacing="4">
                        <Label styleClass="ws-field-label" text="Evidence &amp; Excerpt" />
                        <TextArea fx:id="txtDetailEvidence" editable="false" wrapText="true"
                                  prefRowCount="4" styleClass="ws-text-area" />
                    </VBox>

                    <VBox spacing="4">
                        <Label styleClass="ws-field-label" text="Remediation Guidance" />
                        <TextArea fx:id="txtDetailRemediation" editable="false" wrapText="true"
                                  prefRowCount="3" styleClass="ws-text-area" />
                    </VBox>
                </VBox>

                <!-- Empty Placeholder -->
                <VBox fx:id="detailEmptyBox" spacing="14" styleClass="ws-card">
                    <Label styleClass="ws-card-title" text="Finding Inspector" />
                    <Region styleClass="ws-section-divider" />

                    <VBox alignment="CENTER" spacing="12" minHeight="360">
                        <Label styleClass="ws-empty-icon" text="⚑" />
                        <Label styleClass="ws-empty-title" text="No finding selected" />
                        <Label styleClass="ws-empty-desc"
                               text="Select a finding from the table to inspect full vulnerability analysis, HTTP evidence, remediation guidance, and update its status." />
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>

    </SplitPane>
</VBox>
