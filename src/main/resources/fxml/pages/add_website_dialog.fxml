<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="ws-card" prefWidth="520"
      stylesheets="@../../css/styles.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.webshield.ui.controllers.AddWebsiteController">

    <VBox spacing="4">
        <Label fx:id="lblDialogTitle" styleClass="ws-card-title" text="Register Authorized Website" />
        <Label styleClass="ws-card-subtitle" text="SECURITY TESTING TARGET REGISTRATION" />
    </VBox>

    <Region styleClass="ws-section-divider" />

    <!-- Website Name -->
    <VBox spacing="6">
        <Label styleClass="ws-field-label" text="Website Name *" />
        <TextField fx:id="tfName" promptText="e.g. Production Portal or Internal Demo App"
                   styleClass="ws-text-field" />
    </VBox>

    <!-- Website URL -->
    <VBox spacing="6">
        <Label styleClass="ws-field-label" text="Website URL *" />
        <TextField fx:id="tfUrl" promptText="https://example.com"
                   styleClass="ws-text-field" />
        <Label styleClass="ws-field-hint" text="Must include http:// or https://. The crawler will be restricted to this domain." />
    </VBox>

    <!-- Description -->
    <VBox spacing="6">
        <Label styleClass="ws-field-label" text="Description (Optional)" />
        <TextArea fx:id="taDescription" promptText="Brief notes regarding the target's purpose, environment, or scope..."
                  prefRowCount="3" styleClass="ws-text-area" wrapText="true" />
    </VBox>

    <!-- Authorization Checkbox -->
    <VBox spacing="8" style="-fx-background-color: #F8FAFC; -fx-padding: 12; -fx-border-color: #E2E6ED; -fx-border-radius: 6; -fx-background-radius: 6;">
        <CheckBox fx:id="chkAuthorized" styleClass="ws-check"
                  text="I confirm that I own this website or have explicit written authorization to assess it."
                  wrapText="true" />
        <Label styleClass="ws-field-hint" text="Testing unauthorized targets is illegal and strictly forbidden." />
    </VBox>

    <!-- Validation Error / Status Label -->
    <Label fx:id="lblError" styleClass="ws-auth-error" wrapText="true" />

    <Region styleClass="ws-section-divider" />

    <!-- Actions -->
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button onAction="#onCancel" styleClass="ws-btn-secondary" text="Cancel" />
        <Button fx:id="btnSave" onAction="#onSave" styleClass="ws-btn-primary" text="Register Target" />
    </HBox>

</VBox>

