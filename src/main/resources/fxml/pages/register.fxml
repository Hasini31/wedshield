<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.webshield.ui.controllers.RegisterController"
    styleClass="ws-auth-bg">

    <!-- Centred card -->
    <VBox styleClass="ws-auth-card" alignment="TOP_CENTER" spacing="0"
          maxWidth="400" maxHeight="560">

        <!-- Brand header -->
        <HBox alignment="CENTER" spacing="10" styleClass="ws-auth-brand">
            <HBox alignment="CENTER" styleClass="ws-brand-icon">
                <Label styleClass="ws-brand-icon-text" text="WS" />
            </HBox>
            <Label text="WebShield" styleClass="ws-auth-brand-name" />
        </HBox>

        <!-- Body -->
        <VBox spacing="14" styleClass="ws-auth-body">
            <Label text="Create an account" styleClass="ws-auth-heading" />
            <Label text="All testing must target only authorized systems." styleClass="ws-auth-subheading" />

            <Region minHeight="4" />

            <!-- Full name -->
            <VBox spacing="5">
                <Label text="Full name" styleClass="ws-field-label" />
                <TextField fx:id="fullNameField" styleClass="ws-text-field"
                           promptText="John Smith" />
            </VBox>

            <!-- Email -->
            <VBox spacing="5">
                <Label text="Email address" styleClass="ws-field-label" />
                <TextField fx:id="emailField" styleClass="ws-text-field"
                           promptText="you@example.com" />
            </VBox>

            <!-- Password -->
            <VBox spacing="5">
                <Label text="Password" styleClass="ws-field-label" />
                <PasswordField fx:id="passwordField" styleClass="ws-text-field"
                               promptText="Min 8 chars, upper, lower, digit" />
            </VBox>

            <!-- Confirm Password -->
            <VBox spacing="5">
                <Label text="Confirm password" styleClass="ws-field-label" />
                <PasswordField fx:id="confirmField" styleClass="ws-text-field"
                               promptText="Repeat your password" />
            </VBox>

            <!-- Error / status -->
            <Label fx:id="messageLabel" styleClass="ws-auth-error"
                   wrapText="true" maxWidth="340" />

            <!-- Register button -->
            <Button text="Create Account" onAction="#handleRegister"
                    styleClass="ws-btn-primary" maxWidth="Infinity" />

            <!-- Login link -->
            <HBox alignment="CENTER" spacing="4">
                <Label text="Already have an account?" styleClass="ws-auth-link-label" />
                <Hyperlink text="Sign in" onAction="#goToLogin" styleClass="ws-auth-link" />
            </HBox>
        </VBox>

    </VBox>
</StackPane>
