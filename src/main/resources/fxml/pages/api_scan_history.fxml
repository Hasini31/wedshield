<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.webshield.ui.controllers.ApiScanHistoryController">

    <!-- Top Action Bar -->
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="ws-card"
          style="-fx-background-radius: 0; -fx-border-radius: 0; -fx-border-width: 0 0 1 0; -fx-border-color: #E2E6ED; -fx-padding: 14 24;">
        <TextField fx:id="tfSearch" promptText="Search scans by name or status..."
                   styleClass="ws-text-field" prefWidth="260" />

        <ComboBox fx:id="cbProjectFilter" prefWidth="220" styleClass="ws-combo-box" promptText="Filter by Project..." />

        <Button onAction="#onRefresh" styleClass="ws-btn-secondary" text="🔄 Refresh" />

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnViewFindings" onAction="#onViewFindings" styleClass="ws-btn-primary" text="⚠ View Findings" />
        <Button fx:id="btnViewExecutions" onAction="#onViewExecutions" styleClass="ws-btn-secondary" text="⇄ View Executions" />
        <Button fx:id="btnCompare" onAction="#onCompare" styleClass="ws-btn-secondary" text="⚖ Compare" />
        <Button fx:id="btnDeleteScan" onAction="#onDeleteScan" styleClass="ws-btn-danger" text="🗑 Delete" />
    </HBox>

    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="ws-scroll-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="16" styleClass="ws-content">

            <VBox spacing="12" styleClass="ws-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label styleClass="ws-card-title" text="API Assessment Scan History" />
                        <Label styleClass="ws-card-subtitle" text="PAST RUNS, DURATIONS &amp; VULNERABILITY METRICS" />
                    </VBox>
                    <Label fx:id="lblScanCount" styleClass="ws-badge-info" text="0 scans" />
                </HBox>

                <Region styleClass="ws-section-divider" />

                <TableView fx:id="tableScans" styleClass="ws-table" VBox.vgrow="ALWAYS" minHeight="420">
                    <columns>
                        <TableColumn fx:id="colScanId" text="Scan ID" prefWidth="90" />
                        <TableColumn fx:id="colScanName" text="Scan Name" prefWidth="200" />
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="110" />
                        <TableColumn fx:id="colStartedAt" text="Started At" prefWidth="150" />
                        <TableColumn fx:id="colDuration" text="Duration" prefWidth="85" />
                        <TableColumn fx:id="colTests" text="Tests Gen." prefWidth="90" />
                        <TableColumn fx:id="colRequests" text="Requests" prefWidth="90" />
                        <TableColumn fx:id="colFindings" text="Findings (Summary)" prefWidth="190" />
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10" minHeight="240">
                            <Label styleClass="ws-empty-icon" text="≡" />
                            <Label styleClass="ws-empty-title" text="No past API scans recorded" />
                            <Label styleClass="ws-empty-desc" text="Execute an automated scan to view historical performance and telemetry." />
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>

